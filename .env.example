AUDLI_ENVIRONMENT=development
AUDLI_ALLOWED_ORIGINS=
# Render production: AUDLI_ALLOWED_ORIGINS=https://audli-seven.vercel.app
# Comma-separated exact HTTP(S) origins; no paths or wildcards. Loopback remains allowed.
# Use production to keep error messages and tracebacks out of server logs.
AUDLI_PROVIDER=openai
OPENAI_API_KEY=
AUDLI_LLM_MODEL=gpt-4.1-mini
AUDLI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDLI_SPEECH_MODEL=gpt-4o-mini-tts
AUDLI_VOICE=coral
# Tutor-only opt-in. Ordinary passages keep their provider; accent routing is separately gated below.
AUDLI_TUTOR_TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
AUDLI_ELEVENLABS_MODEL=eleven_flash_v2_5
AUDLI_ELEVENLABS_VOICE_ID=yKYzqEa22xh5PdidhN70
AUDLI_ELEVENLABS_STABILITY=0.5
AUDLI_ELEVENLABS_SIMILARITY_BOOST=0.75
AUDLI_ELEVENLABS_STYLE=0
AUDLI_ELEVENLABS_SPEAKER_BOOST=true
AUDLI_TUTOR_TTS_TIMEOUT_SECONDS=15
AUDLI_TUTOR_TTS_FALLBACK_TIMEOUT_SECONDS=20
AUDLI_DATA_DIR=data
# Local/test storage. Production requires Postgres and Supabase Auth (see docs/AUTHENTICATION.md).
AUDLI_PERSISTENCE=sqlite
AUDLI_DATABASE_URL=
AUDLI_LEARNER_ID=
# Server-only production reset authorization; default denies all accounts.
# JSON array of explicitly authorized Supabase test-user UUIDs. Never use browser metadata.
AUDLI_ONBOARDING_TEST_ACCOUNTS=[]
# Backend-only production example (replace every placeholder; URL-encode the password):
# AUDLI_PERSISTENCE=postgres
# AUDLI_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# Authenticated production: remove AUDLI_LEARNER_ID; account UUIDs come from verified tokens.
AUDLI_EDGE_LOW=0.70
AUDLI_EDGE_HIGH=0.85
AUDLI_LOW_SCORE=0.55
AUDLI_MIN_TRANSCRIPTION_CONFIDENCE=0.65
# Optional offline plumbing demo: requires espeak and ffmpeg.
# AUDLI_PROVIDER=demo

# Terminal coaching message budget, including the deterministic next-step sentence (30–50).
AUDLI_MAX_FEEDBACK_WORDS=50

# Explicit development-only shared identity; production requires supabase.
AUDLI_AUTH_MODE=local
AUDLI_SUPABASE_URL=
AUDLI_SUPABASE_PUBLISHABLE_KEY=
# Production backend: AUDLI_AUTH_MODE=supabase
# AUDLI_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# AUDLI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<PUBLIC_KEY>
# Vercel (or web/.env.local for authenticated development):
# NEXT_PUBLIC_SUPABASE_URL=https://<SAME_PROJECT_REF>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<SAME_PUBLIC_KEY>
# Publishable keys are public; never use service-role/secret keys in either field.

# Global accent practice for every authenticated learner; off until formal review/release gates pass.
AUDLI_ACCENT_PRACTICE_ENABLED=false
AUDLI_PASSAGE_VOICES={}
AUDLI_PASSAGE_REVIEW_DIR=data/voice-evaluation/aud20-validation-20261010
AUDLI_PASSAGE_TTS_MODEL=eleven_flash_v2_5
AUDLI_PASSAGE_TTS_TIMEOUT_SECONDS=20
AUDLI_PASSAGE_TTS_MAX_CONCURRENT=2
AUDLI_PASSAGE_TTS_MAX_CHARACTERS=4000
# Local ceiling required before enabling; durable fleet budget is configured in accent_control.
AUDLI_PASSAGE_TTS_DAILY_CHARACTERS=0

# Shared accent_control starts disabled with daily_limit=0 (migration 003).
# These environment values are ceilings, not shared state. No positive flag cache.
# Operator CLI: python -m scripts.accent_controls status|configure|disable|enable
# Configure/enable production only with explicit authorization; disable needs no API restart.
