AUDLI_ENVIRONMENT=development
AUDLI_ALLOWED_ORIGINS=
# Render production: AUDLI_ALLOWED_ORIGINS=https://audli-seven.vercel.app
# Comma-separated exact HTTP(S) origins; no paths or wildcards. Loopback remains allowed.
# Use production to keep error messages and tracebacks out of server logs.
AUDLI_PROVIDER=openai
OPENAI_API_KEY=
AUDLI_LLM_MODEL=gpt-4.1-mini
AUDLI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDLI_SPEECH_MODEL=gpt-4o-mini-tts
AUDLI_VOICE=coral
AUDLI_DATA_DIR=data
# Local/test storage. Production requires postgres and both values below.
AUDLI_PERSISTENCE=sqlite
AUDLI_DATABASE_URL=
AUDLI_LEARNER_ID=
# Backend-only production example (replace every placeholder; URL-encode the password):
# AUDLI_PERSISTENCE=postgres
# AUDLI_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# AUDLI_LEARNER_ID=<STABLE_LEARNER_UUID>
AUDLI_EDGE_LOW=0.70
AUDLI_EDGE_HIGH=0.85
AUDLI_LOW_SCORE=0.55
AUDLI_MIN_TRANSCRIPTION_CONFIDENCE=0.65
# Optional offline plumbing demo: requires espeak and ffmpeg.
# AUDLI_PROVIDER=demo

# Terminal coaching message budget, including the deterministic next-step sentence (30–50).
AUDLI_MAX_FEEDBACK_WORDS=50
