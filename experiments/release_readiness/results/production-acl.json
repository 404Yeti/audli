{
  "schemas": [
    {
      "acl": "{pg_database_owner=UC/pg_database_owner,=U/pg_database_owner,postgres=U/pg_database_owner,anon=U/pg_database_owner,authenticated=U/pg_database_owner,service_role=U/pg_database_owner}",
      "name": "public",
      "owner": "pg_database_owner"
    }
  ],
  "event_triggers": [
    {
      "name": "issue_graphql_placeholder",
      "event": "sql_drop",
      "enabled": "O",
      "function": "set_graphql_placeholder"
    },
    {
      "name": "pgrst_ddl_watch",
      "event": "ddl_command_end",
      "enabled": "O",
      "function": "pgrst_ddl_watch"
    },
    {
      "name": "pgrst_drop_watch",
      "event": "sql_drop",
      "enabled": "O",
      "function": "pgrst_drop_watch"
    },
    {
      "name": "issue_pg_cron_access",
      "event": "ddl_command_end",
      "enabled": "O",
      "function": "grant_pg_cron_access"
    },
    {
      "name": "issue_pg_net_access",
      "event": "ddl_command_end",
      "enabled": "O",
      "function": "grant_pg_net_access"
    },
    {
      "name": "issue_pg_graphql_access",
      "event": "ddl_command_end",
      "enabled": "O",
      "function": "grant_pg_graphql_access"
    },
    {
      "name": "ensure_rls",
      "event": "ddl_command_end",
      "enabled": "O",
      "function": "rls_auto_enable"
    }
  ],
  "default_privileges": [
    {
      "acl": "{postgres=rwU/supabase_admin,anon=rwU/supabase_admin,authenticated=rwU/supabase_admin,service_role=rwU/supabase_admin}",
      "type": "S",
      "owner": "supabase_admin",
      "schema": "public"
    },
    {
      "acl": "{postgres=arwdDxtm/supabase_admin,anon=arwdDxtm/supabase_admin,authenticated=arwdDxtm/supabase_admin,service_role=arwdDxtm/supabase_admin}",
      "type": "r",
      "owner": "supabase_admin",
      "schema": "public"
    },
    {
      "acl": "{postgres=X/supabase_admin,anon=X/supabase_admin,authenticated=X/supabase_admin,service_role=X/supabase_admin}",
      "type": "f",
      "owner": "supabase_admin",
      "schema": "public"
    },
    {
      "acl": "{postgres=arwdDxtm/postgres,anon=Dxtm/postgres,authenticated=Dxtm/postgres,service_role=Dxtm/postgres}",
      "type": "r",
      "owner": "postgres",
      "schema": "public"
    },
    {
      "acl": "{postgres=rwU/postgres}",
      "type": "S",
      "owner": "postgres",
      "schema": "public"
    },
    {
      "acl": "{postgres=X/postgres}",
      "type": "f",
      "owner": "postgres",
      "schema": "public"
    }
  ],
  "public_function_security": [
    {
      "name": "lesson_entitlement_guard()",
      "config": null,
      "definer": false,
      "has_rls_enable": false
    },
    {
      "name": "rls_auto_enable()",
      "config": [
        "search_path=pg_catalog"
      ],
      "definer": true,
      "has_rls_enable": true
    }
  ]
